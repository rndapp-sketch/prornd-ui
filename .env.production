VITE_BASE_PATH=
VITE_CANDIDATE_API_URL=https://iitg.ac.in/rndproj/recruitment

# Backend hosts (used by proxyOptions.ts and by src/ code that talks to
# these services directly, e.g. building file/asset URLs). These centralize
# IPs (and ports) that were previously hardcoded inline.
# Note: the main app backend's *port* for the dev proxy still comes from
# common_site_config.json's webserver_port (unchanged). VITE_APP_BACKEND_PORT
# only exists for src/ (browser-side) code that can't read that JSON file.
VITE_APP_BACKEND_HOST=172.16.131.206
VITE_APP_BACKEND_PORT=8000
# Port for the separate "universal-registration" service on the same host.
VITE_APP_BACKEND_REGISTRATION_PORT=8081
VITE_MINIO_HOST=172.16.135.118
VITE_MINIO_PORT=9000
# Alternate MinIO port used by some already-uploaded file URLs.
VITE_MINIO_ALT_PORT=8081
VITE_LEDGER_HOST=172.16.134.81
VITE_LEDGER_PORT=18080
VITE_ATTENDANCE_HOST=172.16.135.27
VITE_ATTENDANCE_PORT=7078
# Port for the separate Project Staff SSO endpoint on the same host.
VITE_ATTENDANCE_SSO_PORT=7079
VITE_ASSET_HOST=172.16.117.39
VITE_ASSET_PORT=8000
# Host/port for the Appwrite dev proxy target (proxyOptions.ts `/appwrite`).
# Kept consistent with VITE_APPWRITE_ENDPOINT's host below.
VITE_APPWRITE_HOST=172.16.134.179
VITE_APPWRITE_PORT=9080

# Appwrite messaging backend
# In production/hosted builds, do not use /appwrite/v1 unless the web server
# also proxies /appwrite to Appwrite. Vite's dev proxy is not available here.
VITE_APPWRITE_ENDPOINT=http://172.16.134.179:9080/v1
VITE_APPWRITE_PROJECT_ID=6a0201f20025d8289f76
VITE_APPWRITE_PROJECT_NAME=ProRnD
VITE_APPWRITE_DATABASE_ID=prornd_messaging
VITE_APPWRITE_CONVERSATIONS_COLLECTION_ID=conversations
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
VITE_APPWRITE_ATTACHMENTS_BUCKET_ID=message_attachments
