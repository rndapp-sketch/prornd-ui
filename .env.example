# Copy to .env (development) or .env.production (build) and adjust.
# Vite loads .env in every mode; .env.production overrides it for `yarn build`.

# ── Frappe backend ───────────────────────────────────────────────────────────
# Base URL for all Frappe requests (/api, /files, /private, /assets, /login).
# Dev: relative path, forwarded by the Vite proxy.  Prod: full public HTTPS URL.
#   dev:  /bk-api
#   prod: https://<your-domain>/bk-api
VITE_FRAPPE_BASE_URL=/bk-api
VITE_BASE_PATH=

# Recruitment / candidate API (production only)
# VITE_CANDIDATE_API_URL=https://<your-domain>/rndproj/recruitment

# ── Backend hosts (dev proxy in proxyOptions.ts + browser-side URL building) ─
# The dev proxy port for the main backend comes from common_site_config.json
# (webserver_port); VITE_APP_BACKEND_PORT is only for browser-side code.
VITE_APP_BACKEND_HOST=172.16.131.206
VITE_APP_BACKEND_PORT=8000
# Separate "universal-registration" service on the same host
VITE_APP_BACKEND_REGISTRATION_PORT=8081

# MinIO (file storage)
VITE_MINIO_HOST=172.16.134.179
VITE_MINIO_PORT=9000
# Alternate port used by some already-uploaded file URLs
VITE_MINIO_ALT_PORT=8081

# Ledger service
VITE_LEDGER_HOST=172.16.134.81
VITE_LEDGER_PORT=18080

# Attendance service
VITE_ATTENDANCE_HOST=172.16.135.27
VITE_ATTENDANCE_PORT=7078
# Project Staff SSO endpoint on the same host
VITE_ATTENDANCE_SSO_PORT=7079

# Asset host
VITE_ASSET_HOST=172.16.131.206
VITE_ASSET_PORT=8000

# ── Appwrite (messaging) ─────────────────────────────────────────────────────
# Dev proxy target (proxyOptions.ts `/appwrite`)
VITE_APPWRITE_HOST=172.16.134.179
VITE_APPWRITE_PORT=9080
# Endpoint the browser calls.
#   dev:  /chat-api/v1
#   prod: https://<your-domain>/chat-api/v1  (proxied by nginx; never the raw IP)
VITE_APPWRITE_ENDPOINT=/chat-api/v1
VITE_APPWRITE_PROJECT_ID=6a0201f20025d8289f76
VITE_APPWRITE_PROJECT_NAME=ProRnD

# IDs configured in the Appwrite console
VITE_APPWRITE_DATABASE_ID=prornd_messaging
VITE_APPWRITE_CONVERSATIONS_COLLECTION_ID=conversations
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
VITE_APPWRITE_ATTACHMENTS_BUCKET_ID=message_attachments
